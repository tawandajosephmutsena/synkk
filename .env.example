APP_NAME=Synkk
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# SQLite Concurrency Configuration
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=wal
DB_SYNCHRONOUS=normal

# Synkk Platform Configuration
SYNKK_STORAGE_DISK=local
SYNKK_MAX_BATCH_SIZE=100
SYNKK_VERSION_RETENTION_LIMIT=25
SYNKK_ENFORCE_LICENSE=false
LEMON_SQUEEZY_STORE_URL=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_PRODUCT_ID=

# Dodo Payments Cloud subscriptions
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_BASE_URL=https://test.dodopayments.com
DODO_PAYMENTS_CLOUD_PRODUCT_ID=
DODO_PAYMENTS_AI_ADDON_PRODUCT_ID=
DODO_PAYMENTS_CURRENCY=USD
DODO_PAYMENTS_GRACE_PERIOD_DAYS=7
DODO_PAYMENTS_WEBHOOK_TOLERANCE_SECONDS=300

# Reverse Proxy Configuration (leave empty for direct exposure; comma-separated CIDRs/IPs when behind Nginx/Cloudflare)
TRUSTED_PROXIES=

VITE_APP_NAME="${APP_NAME}"

# Synkk Opt-In AI Add-On (Managed Cloud Inference & Credit Allowances)
SYNKK_AI_ADDON_PRICE=12
SYNKK_AI_MANAGED_PROVIDER=openai_compatible
SYNKK_AI_MANAGED_BASE_URL=https://openrouter.ai/api/v1
SYNKK_AI_MANAGED_API_KEY=
SYNKK_AI_MANAGED_CHAT_MODEL=openai/gpt-4o-mini
SYNKK_AI_MANAGED_FAST_MODEL=openai/gpt-4o-mini
SYNKK_AI_MANAGED_EMBEDDING_PROVIDER=openai_compatible
SYNKK_AI_MANAGED_EMBEDDING_BASE_URL=https://api.openai.com/v1
SYNKK_AI_MANAGED_EMBEDDING_API_KEY=
SYNKK_AI_MANAGED_EMBEDDING_MODEL=text-embedding-3-small
SYNKK_AI_TRIAL_MICROCENTS=200000000
SYNKK_AI_MONTHLY_MICROCENTS=1200000000
