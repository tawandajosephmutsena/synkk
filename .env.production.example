# ==============================================================================
# Synkk Production Environment Configuration
# ==============================================================================

APP_NAME="Synkk Vault Sync"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:GENERATE_ME_USING_INSTALL_SCRIPT
APP_URL=https://synkk.your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Database Configuration (SQLite default for zero-maintenance self-hosting)
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite

# Queue, Cache, and Sessions
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Storage Engine (Local SQLite + Filesystem)
SYNKK_STORAGE_DISK=local
FILESYSTEM_DISK=local

# Broadcasting & WebSockets (Laravel Reverb)
BROADCAST_CONNECTION=reverb
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=synkk.your-domain.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_APP_ID=synkk-local-app
REVERB_APP_KEY=synkk-reverb-key
REVERB_APP_SECRET=synkk-reverb-secret

# Caddy Reverse Proxy & Domain Settings
SYNKK_DOMAIN=synkk.your-domain.com
CADDY_EMAIL=admin@your-domain.com

# Licensing & Pro Controls (Disabled by default for self-hosters)
SYNKK_ENFORCE_LICENSE=false
