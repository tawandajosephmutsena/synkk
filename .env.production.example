# ==============================================================================
# Synkk Production Environment Configuration
# ==============================================================================

APP_NAME="Synkk Vault Sync"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:GENERATE_ME_USING_INSTALL_SCRIPT
APP_URL=https://synkk.your-domain.com

# Set both values before the first start to create the initial owner account.
# Use a unique password; keep this file private and remove these values after
# the first successful login. The account is not changed on later restarts.
# SYNKK_BOOTSTRAP_EMAIL=you@your-domain.com
# SYNKK_BOOTSTRAP_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD
# SYNKK_BOOTSTRAP_NAME=Administrator

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Database Configuration (SQLite default for zero-maintenance self-hosting)
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/app/database.sqlite

# Queue, Cache, and Sessions
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Storage Engine (Local SQLite + Filesystem)
SYNKK_STORAGE_DISK=local
FILESYSTEM_DISK=local

# Broadcasting & WebSockets (Laravel Reverb)
BROADCAST_CONNECTION=reverb
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# Server-side publishing uses Reverb inside this container. Browser clients
# connect to the same HTTPS origin as APP_URL through the reverse proxy.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_APP_ID=synkk-local-app
REVERB_APP_KEY=synkk-reverb-key
REVERB_APP_SECRET=synkk-reverb-secret

# Caddy Reverse Proxy & Domain Settings
SYNKK_DOMAIN=synkk.your-domain.com
CADDY_EMAIL=admin@your-domain.com
# The Compose HTTP port is bound to host loopback; trust your local HTTPS
# reverse proxy's forwarded scheme and host headers.
TRUSTED_PROXIES=*

# Configure SMTP before using invitations, password recovery, or email changes.
# With the default log mailer, messages are written to container logs only.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=admin@your-domain.com
MAIL_FROM_NAME="Synkk"
# MAIL_HOST=smtp.your-provider.com
# MAIL_PORT=587
# MAIL_SCHEME=smtp
# MAIL_USERNAME=
# MAIL_PASSWORD=

# Licensing & Pro Controls (Disabled by default for self-hosters)
SYNKK_ENFORCE_LICENSE=false
