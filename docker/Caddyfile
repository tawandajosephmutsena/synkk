{
    # Global options
    email {$CADDY_EMAIL:admin@synkk.space}
    admin off
}

{$SYNKK_DOMAIN:localhost} {
    # Reverse proxy all HTTP and WebSocket traffic to the Synkk container on port 80.
    # Nginx inside the container automatically handles both HTTP and WebSocket upgrades on /app/.
    reverse_proxy app:80 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Encode responses with gzip and zstandard compression
    encode zstd gzip

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Livewire requires unsafe-inline for scripts; restrict everything else.
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' wss: ws:; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        -Server
    }

    # Logging
    log {
        output stdout
        format console
        level INFO
    }
}
